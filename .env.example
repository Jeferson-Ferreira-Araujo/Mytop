# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
# Project URL + anon key are safe to expose to the browser (used only
# for Realtime subscriptions on the `rooms` and `participants` tables).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY, never exposed to the client.
# Used by API routes to read/write rankings and ranking_items.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------
# TMDB (movies, tv, "characters" via person search)
# https://www.themoviedb.org/settings/api
# ------------------------------------------------------------------
TMDB_API_KEY=your-tmdb-v3-api-key

# Música (tracks, artists, albums) usa a API pública da Deezer —
# não precisa de chave/conta, então não há variável aqui.

# ------------------------------------------------------------------
# IGDB (games) — auth is via Twitch app tokens
# https://api-docs.igdb.com/#getting-started
# ------------------------------------------------------------------
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# ------------------------------------------------------------------
# Unsplash (generic themes / free-text items)
# https://unsplash.com/developers
# ------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# TheMealDB (food) needs no key for the MVP — the free "1" test key is
# used by default. Set this to your own key if you upgrade later.
THEMEALDB_API_KEY=1
